# Export these in your shell; this project does not load .env automatically.
# Generate a random key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
HTTPS_ENABLED=false
# Optional absolute paths; defaults are within the project directory.
# SQLITE_PATH=/path/to/data/db.sqlite3
# MEDIA_ROOT=/path/to/data/media
# PRIVATE_MEDIA_ROOT=/path/to/data/private_media
